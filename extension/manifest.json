{
  "manifest_version": 3,
  "name": "OCI Login Companion",
  "description": "테넌시를 검색하고 Enter. 아이디·비밀번호·Bypass Code까지 OCI 전용 자동 로그인.",
  "version": "1.3.2",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "https://cloud.oracle.com/*",
    "https://*.oraclecloud.com/*",
    "https://www.oracle.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OCI 계정 검색",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "OCI 계정 검색 열기"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "incognito": "spanning"
}
